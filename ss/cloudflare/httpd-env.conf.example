SetEnv APP_ENV production
SetEnv SUPERMERCADO_TRUST_CLOUDFLARE_PROXY 1
SetEnv SUPERMERCADO_PUBLIC_URL https://portal.supermercado.com
SetEnv SUPERMERCADO_DB_HOST 127.0.0.1
